# Gateway (local — 127.0.0.1 only)
LAYA_GATEWAY_BIND=127.0.0.1:8790
LAYA_GATEWAY_ROUTING=on
LAYA_GATEWAY_MIN_CONFIDENCE=0.55
LAYA_GATEWAY_LAYA_TIMEOUT_MS=800
LAYA_GATEWAY_UPSTREAM_TIMEOUT_MS=120000
LAYA_GATEWAY_MAX_EVENTS=200

# Laya System One (DEV Octor VPN or local serve)
# Example DEV: http://10.8.0.9:8343/v1/systemone
LAYA_URL=http://127.0.0.1:8000/v1/systemone
LAYA_API_KEY=
LAYA_MODEL=

# Upstream LLM (OpenAI-compatible). Leave empty to require
# clients to send Authorization; gateway forwards the header.
LLM_UPSTREAM_URL=https://api.openai.com/v1
LLM_API_KEY=

# Dashboard (Next)
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8790
